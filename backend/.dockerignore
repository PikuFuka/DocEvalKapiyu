# Virtual environments - CRITICAL to exclude
venom/
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Misc
.env
.env.local
*.log
.DS_Store
Thumbs.db

# Media files (handled by volumes)
media/*
!media/.gitkeep

# Static files (generated)
staticfiles/
